# Vorlage: nach .env.local kopieren und Werte eintragen (.env.local wird NICHT committet).
# Auf Vercel dieselben Variablen unter Settings -> Environment Variables setzen.

# PostgreSQL-Verbindung, z. B. von Neon oder Supabase (auf Vercel die "pooled" URL verwenden)
DATABASE_URL="postgresql://USER:PASSWORT@HOST/DBNAME?sslmode=require"

# 32 Zeichen, pro Umgebung neu erzeugen: openssl rand -hex 16
SESSION_SECRET_KEY=""
